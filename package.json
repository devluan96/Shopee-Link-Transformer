{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "description": "HotsNew Click desktop shell",
  "author": "HotsNew Click",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "tsx server/app.ts",
    "dev:client": "vite --port 5173",
    "build": "vite build",
    "desktop:dev": "node ./scripts/start-electron-dev.cjs",
    "desktop:build": "node ./scripts/build-desktop.cjs",
    "desktop:publish:r2": "node ./scripts/publish-desktop-to-r2.cjs",
    "desktop:publish": "node ./scripts/publish-desktop-to-r2.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint:ts": "node ./scripts/run-tsc.cjs",
    "lint:eslint": "eslint --config .eslintrc.cjs . --ext .ts,.tsx",
    "lint": "node ./scripts/run-tsc.cjs",
    "test": "node ./scripts/run-tests.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.10.2",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nanoid": "^5.1.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^2.0.9",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@eslint/js": "^9.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supabase": "^2.98.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "click.hotsnew.desktop",
    "productName": "HotsNew Click",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "app": "electron-app",
      "buildResources": "desktop-assets",
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://hotsnew.click/downloads"
      }
    ],
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "icon.ico",
      "executableName": "HotsNew Click",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "shortcutName": "HotsNew Click",
      "runAfterFinish": false,
      "artifactName": "hotsnew-click-setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "hotsnew-click-portable-${version}-${arch}.${ext}"
    }
  }
}
