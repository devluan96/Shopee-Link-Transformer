# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public download link for install center
# Recommended: point directly to a GitHub Release asset for the Windows installer
# Example: https://github.com/devluan96/Shopee-Link-Transformer/releases/download/v0.0.1/hotsnew-click-setup-0.0.1-x64.exe
VITE_DESKTOP_APP_URL=

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional fallback Cloudinary accounts used after the primary account reaches quota.
CLOUDINARY_CLOUD_NAME_2=
CLOUDINARY_API_KEY_2=
CLOUDINARY_API_SECRET_2=
CLOUDINARY_CLOUD_NAME_3=
CLOUDINARY_API_KEY_3=
CLOUDINARY_API_SECRET_3=
CLOUDINARY_CLOUD_NAME_4=
CLOUDINARY_API_KEY_4=
CLOUDINARY_API_SECRET_4=
CLOUDINARY_CLOUD_NAME_5=
CLOUDINARY_API_KEY_5=
CLOUDINARY_API_SECRET_5=
DISABLE_CLOUDINARY_UPLOAD=
ENABLE_CLOUDINARY_BACKUP=true

# Local media storage
LOCAL_MEDIA_STORAGE_DIR=uploads/media
LOCAL_MEDIA_PUBLIC_PATH=media
# Provider order for image uploads and fallback behavior.
# Video uploads currently prefer Cloudinary first in code.
MEDIA_UPLOAD_PROVIDER_ORDER=r2,cloudinary,supabase

# API CORS origins for local development and production
# Example: http://localhost:3000,http://localhost:5173,https://hotsnew.click,https://test.hotsnew.click
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare R2 media storage
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_BYTES=104857600

# Cloudflare R2 bucket CORS must also allow the app origins above.
# Example bucket CORS origins:
# http://localhost:3000
# http://localhost:5173
# https://hotsnew.click
# https://test.hotsnew.click

# AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REVIEW_MODEL=
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
SYNC_API_KEY=
SYNC_BASE_URL=https://api.sync.so/v2
FFMPEG_PATH=

# Supabase media buckets
SUPABASE_IMAGE_BUCKET=
SUPABASE_VIDEO_BUCKET=
SUPABASE_AUDIO_BUCKET=
SUPABASE_UPLOAD_BUCKET=
SUPABASE_UPLOAD_FOLDER=
SUPABASE_MAX_UPLOAD_BYTES=

# Security - Encryption key for sensitive data (OAuth tokens, 2FA secrets)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_ENCRYPTION_KEY=

# Public app URL used for payment redirect/callback
APP_BASE_URL=
VITE_APP_BASE_URL=

# Output domains for generated public links.
# Use the staging domain in Preview/Staging and the live domain in Production.
# Example staging: test.hotsnew.click
# Example production: hotsnew.click
LINK_OUTPUT_DOMAINS=
VITE_LINK_OUTPUT_DOMAINS=

# Manual bank transfer QR config for pricing page
VITE_PAYMENT_BANK_ID=
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NO=
VITE_PAYMENT_ACCOUNT_NAME=


