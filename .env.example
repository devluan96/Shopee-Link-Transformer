# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public download link for install center
# Example: https://hotsnew.click/downloads/hotsnew-click-setup-0.0.0-x64.exe
VITE_DESKTOP_APP_URL=

# Optional: external package URL for nsis-web installer.
# When set, the small setup.exe can stay on your web app host
# while the large .nsis.7z package is downloaded from another host during install.
# Example:
# DESKTOP_APP_PACKAGE_URL=https://files.your-host.com/hotsnew-click-desktop-0.0.0-x64.nsis.7z
DESKTOP_APP_PACKAGE_URL=

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public app URL used for payment redirect/callback
APP_BASE_URL=

# ZaloPay Gateway Config
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_API_BASE_URL=
